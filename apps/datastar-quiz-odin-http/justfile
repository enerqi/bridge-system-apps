#
# The quiz app
#
# The FIFTH implementation of the bidding quiz (python -> go -> rust -> tina -> here), and the second
# in Odin. Same corpus, same routes, same wire protocol, driven by the same `apps/dsquiz-perf`
# harness as the others. Port 5062, so it runs beside python 5008, go 5060 and tina 5061.
#
# Everything except `web/` is the tina port's source, unchanged -- which is the point: the two Odin
# ports differ in their HTTP runtime and in nothing else, so a difference between them is the
# runtime's.
#

# serve the quiz, optimised, WITHOUT the brotli encoder. Everyday development.
[group('run')]
serve *args: (run_release args)

# The build RESULTS.md measures, and the only one comparable to the other four: they all compress at
# brotli q5 with a 256-byte minimum. Off by default because it needs `just build-brotli` to have
# staged `target/brotli/*.lib` first (that library is somebody else's source and is not vendored
# here); everything else about the two builds is identical.
# ---
# serve the quiz, optimised, WITH brotli. Needs a prior `just build-brotli`
[group('run')]
serve-brotli *args: (run_release "-define:DSQUIZ_BROTLI=true" args)

# serve the quiz with bounds checks and debug info, for development
[group('run')]
serve-debug *args: (run_debug args)

# serve WITH brotli, with bounds checks and debug info
[group('run')]
serve-brotli-debug *args: (run_debug "-define:DSQUIZ_BROTLI=true" args)

# odin-http defaults to (cores - 1) threads, each with its own event loop; this port defaults to ONE
# so it is measured against the same budget as the python's single asyncio loop, tina's one shard and
# `just dsgo serve-1core`. DSQUIZ_THREADS raises it, and the shared session store takes its mutex.
# ---
# serve with every core, not the like-for-like single loop
[group('run')]
[windows]
serve-all-cores *args:
	set DSQUIZ_THREADS=0&& just serve {{args}}

# serve with every core, not the like-for-like single loop
[group('run')]
[unix]
serve-all-cores *args:
	DSQUIZ_THREADS=0 just serve {{args}}

# run every package's tests (`test` alone is the root package, which holds no logic)
#
# One `odin test` per package rather than one over the tree: each package is its own compilation, and
# the http-facing ones cannot carry the strict flags anyway. Also keeps a failure named by package.
[group('test')]
[script]
test-all *args:
	import pathlib, subprocess, sys

	root = pathlib.Path(r"{{ source_directory() }}")
	skip = {"target", "bench", ".just", ".sublime", "assets", "testdata"}
	packages = sorted(
		d for d in root.iterdir()
		if d.is_dir() and d.name not in skip and not d.name.startswith(".")
		and any(d.glob("*_test.odin"))
	)

	failed = []
	for package in packages:
		out = root / "target" / "debug" / f"{package.name}-test.exe"
		command = [
			"odin", "test", str(package), "-debug", "-file",
			f"-out:{out}", *r"""{{args}}""".split(),
		]
		if subprocess.run(command).returncode != 0:
			failed.append(package.name)
	if failed:
		print(f"tests failed: {', '.join(failed)}", file=sys.stderr)
	raise SystemExit(1 if failed else 0)

# everything a change has to pass: format, both lints, every package's tests
[group('qa')]
qa: format lint lint-strict test-all

# NOT a dependency of `serve`: the encoder is compiled in only with `-define:DSQUIZ_BROTLI=true`
# (`just serve-brotli`). The MSVC toolchain and the STATIC runtime both matter -- CMake picks
# whatever compiler it finds, and radlink cannot read the GNU `.a` that produces, while a `/MD` build
# links but references `__imp_malloc`. The tina port's README has the full account.
# ---
# build the brotli encoder from ~/dev/brotli into target/brotli/ (needs cmake, ninja and MSVC)
[group('build')]
[script]
build-brotli:
	import os, pathlib, shutil, subprocess, sys

	home = pathlib.Path(os.environ.get("BROTLI_HOME", pathlib.Path.home() / "dev" / "brotli"))
	if not (home / "CMakeLists.txt").exists():
		sys.exit(f"no brotli checkout at {home} (set BROTLI_HOME)")

	vcvars = pathlib.Path(
		r"C:\Program Files\Microsoft Visual Studio\18\Community\VC\Auxiliary\Build\vcvars64.bat"
	)
	build = home / "build-mt"
	configure = (
		f'cmake -S . -B build-mt -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF '
		f'-DBROTLI_DISABLE_TESTS=ON -DCMAKE_C_COMPILER=cl -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded'
	)
	script = f'@echo off\ncall "{vcvars}" >nul\ncd /d {home}\n{configure}\ncmake --build build-mt --target brotlienc\n'
	batch = pathlib.Path(os.environ.get("TEMP", ".")) / "dsquiz-build-brotli.bat"
	batch.write_text(script, encoding="utf-8")
	if subprocess.run(["cmd", "/c", str(batch)]).returncode != 0:
		sys.exit("brotli build failed")

	out = pathlib.Path(r"{{ source_directory() }}") / "target" / "brotli"
	out.mkdir(parents=True, exist_ok=True)
	for name in ("brotlienc.lib", "brotlicommon.lib"):
		shutil.copy2(build / name, out / name)
	print(f"brotli -> {out}")

#
# Diagnostics kept because their findings are quoted in README.md and RESULTS.md
#

# The nbio timer repro behind README.md, "The trap this port paid for". Three modes, each 12 chained
# 100 ms timeouts: `plain` alone, `with_date` alongside a 1 s repeating timer (what odin-http's date
# header uses), and `after_send` re-arming from a SEND COMPLETION, which is the shape the SSE
# choreography has. The third is the one that runs at ~1000 ms instead of ~109.
# ---
# is a chained core:nbio timeout accurate? (plain | with_date | after_send)
[group('perf')]
nbio-timer mode="after_send": mktarget_dirs
	odin run tools/nbiotimer -out:{{ target_path("debug", "nbiotimer.exe") }} -- {{mode}}

# Timestamp every SSE frame of one answer against a RUNNING server. The pacing gate: a correct
# answer's script is 0.5 + 0.5 + 0.5 + 1.0 s of deliberate beats and should arrive that way.
# ---
# timestamp one answer's SSE frames (needs a running server)
[group('perf')]
sse-probe base="http://127.0.0.1:5062" index="0":
	uv run --no-project --with httpx python tools/sse_probe.py {{base}} {{index}}

# The held countdown ticks at 100 ms. Measures 20 of them, so a regression in the timer path shows up
# as a mean gap of ~1000 ms rather than ~109. Needs DSQUIZ_TIMER=stream.
# ---
# measure the held /timer stream's tick spacing (needs DSQUIZ_TIMER=stream)
[group('perf')]
timer-probe base="http://127.0.0.1:5062":
	uv run --no-project --with httpx python tools/timer_probe.py {{base}}

# Per-connection resident memory: open N keep-alive sockets, ONE request each, hold them, sample the
# server's working set. The slope is the per-connection cost, and it is what the memory row in
# RESULTS.md is made of -- a connection holds its own high-water mark until it closes.
# ---
# per-connection memory cost for one route (needs a running server)
[group('perf')]
conn-cost path="/":
	python tools/conn_cost.py {{path}}
