{
	// Similar to the Odin.sublime-build but trys to use the target directory to store output artifacts
	// $folder is the top level folder in the side bar which will work without projects and without the assumption
	// that the project file is in the same directory as its contents
	// $file_base_name is the file name, exluding the extension, of the file in the active view.
	// ${file_path/^.*\\\\//} is `sed` like substitution to get the basename of the current file's folder without the
	// full path to the directory being included
	// We assume a justfile in the top level folder / project root with a `mktarget_dirs` task (recipe).
	//
	// Separate profile sub-folders can exist dev/debug vs release etc. can be created, though odin generally compiles
	// fast enough, caveat llvm being slow, such that full rebuilds each time for small profile variations are not that
	// painful.
	//
	// Ensuring the target directory exists is awkward - shell_cmd is ugly and os specific with mkdir failing on windows
	// if it already exists. Deferring to a task in a justfile works fine but assumes the existence of just and a just
	// file, in which case we could also assume some cross platform mkdir script exists. These are the sort of reasons
	// rustc has the all in one cargo utility. Just recipes conveniently (?) don't return non-zero when a step fails,
	// though it will not run the next step within a task on non-zero unless the task is prefixed with "-":
	// https://just.systems/man/en/chapter_30.html?highlight=exit%20code#ignoring-errors
	"selector": "source.odin",
	"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
	"shell_cmd": "odin check \"$file_path\" -no-entry-point",
	"variants": [
		//
		// whole project -- delegates to the justfile in the top level side bar folder. `just` treats an
		// argument containing a `/` as <dir>/<recipe> and searches for the justfile from <dir>, so these work
		// regardless of which file is active.
		//
		// Both project kinds are listed on purpose. `just install-sublime` copies this file into
		// Sublime's global `Packages/User`, where it matches on `source.odin` and therefore serves every
		// Odin project on the machine at once - so it cannot be specialised to the project it was
		// scaffolded from. A variant naming a recipe the current project does not define simply fails
		// if you pick it; a variant missing from the global copy is gone everywhere.
		//
		// executable projects:
		{ "name": "project - just run (debug)", "shell_cmd": "just \"$folder/run\"" },
		{ "name": "project - just run_fast_debug", "shell_cmd": "just \"$folder/run_fast_debug\"" },
		{ "name": "project - just run_release_debug", "shell_cmd": "just \"$folder/run_release_debug\"" },
		{ "name": "project - just run_release", "shell_cmd": "just \"$folder/run_release\"" },
		{ "name": "project - just run_release_nochecks", "shell_cmd": "just \"$folder/run_release_nochecks\"" },
		{ "name": "project - just sanitize (address)", "shell_cmd": "just \"$folder/sanitize\"" },
		{ "name": "project - just diagnose", "shell_cmd": "just \"$folder/diagnose\"" },
		// library projects:
		{ "name": "project - just check", "shell_cmd": "just \"$folder/check\"" },
		{ "name": "project - just example basic", "shell_cmd": "just \"$folder/example\" basic" },
		{ "name": "project - just examples-check", "shell_cmd": "just \"$folder/examples-check\"" },
		{ "name": "project - just doc", "shell_cmd": "just \"$folder/doc\"" },
		// either:
		{ "name": "project - just test", "shell_cmd": "just \"$folder/test\"" },
		{ "name": "project - just test_sanitize (address)", "shell_cmd": "just \"$folder/test_sanitize\"" },
		{ "name": "project - just lint", "shell_cmd": "just \"$folder/lint\"" },
		{ "name": "project - just format", "shell_cmd": "just \"$folder/format\"" },
		{ "name": "project - just clean", "shell_cmd": "just \"$folder/clean\"" },
		//
		// current file
		//
		// syntax check
		{ "name": "current file - syntax check", "shell_cmd": "odin check \"$file\" -file -no-entry-point" },
		{ "name": "current file - strict vet check", "shell_cmd": "odin check \"$file\" -file -vet -vet-cast -strict-style -vet-tabs -no-entry-point" },
		// run
		{ "name": "current file - run (debug, o:none)", "shell_cmd": "just \"$folder/mktarget_dirs\" && odin run \"$file\" -file -out:$folder/target/debug/\"$file_base_name.exe\" -o:none -debug" },
		{ "name": "current file - run (o:size)", "shell_cmd": "just \"$folder/mktarget_dirs\" && odin run \"$file\" -file -out:$folder/target/release/\"$file_base_name.exe\" -o:size" },
		{ "name": "current file - run (o:size, no-bounds-check)", "shell_cmd": "just \"$folder/mktarget_dirs\" && odin run \"$file\" -file -out:$folder/target/release/\"$file_base_name.exe\" -o:size -no-bounds-check" },
